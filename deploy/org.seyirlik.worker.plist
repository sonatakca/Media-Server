<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Seyirlik's background work — scanning, probing, artwork, and every encode —
  in a process of its own.

  Install this alongside the server job and set `SEYIRLIK_RUN_WORKER=false` in
  `.env`, and the two halves stop sharing a fate: restarting the site from the
  Server Control page no longer abandons an encode half-way through, and an
  encoder that wedges no longer takes playback down with it. They meet only in
  the job queue in PostgreSQL, which is what carries a job across either one
  restarting.

  `ProcessType` must not be `Background`, however tempting the name is for a
  job that encodes in the background. On Apple silicon that class is not a mild
  deprioritisation: it clamps the whole process tree to the efficiency cores
  and throttles its disk I/O. Measured on this machine, one 4K HDR ladder ran
  at 1.8x under `Standard` and 0.07x under `Background` — a thirty-hour encode
  instead of a ninety-minute one.

  Keeping playback ahead of encoding is the server job's `Interactive` class
  doing its work, not this one being crippled: the scheduler already prefers
  the server whenever both want the CPU.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>org.seyirlik.worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/opt/node@22/bin/node</string>
    <string>--env-file=.env</string>
    <string>--import</string>
    <string>tsx</string>
    <string>src/server/mediaWorker.ts</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/sonat/Documents/Development/Media-Server</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/opt/node@22/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Standard</string>
  <key>StandardOutPath</key><string>/Users/sonat/Library/Logs/Seyirlik/worker.log</string>
  <key>StandardErrorPath</key><string>/Users/sonat/Library/Logs/Seyirlik/worker.log</string>
</dict>
</plist>
