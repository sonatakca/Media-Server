{
  "name": "seyirlik-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "playback:backend": "node --env-file=.env --import tsx src/server/playbackBackend.ts",
    "server": "node --env-file=.env --import tsx src/server/mediaServer.ts",
    "worker": "node --env-file=.env --import tsx src/server/mediaWorker.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "audit:jellyfin": "node scripts/audit-jellyfin-runtime.mjs",
    "db:migrate": "tsx scripts/run-own-api-migrations.ts",
    "admin:provision": "tsx scripts/provision-native-admin.ts",
    "media:renditions:analyse": "tsx scripts/media-renditions.ts analyse",
    "media:renditions:process": "tsx scripts/media-renditions.ts process",
    "media:renditions:resume": "tsx scripts/media-renditions.ts resume",
    "media:renditions:status": "tsx scripts/media-renditions.ts status",
    "media:renditions:validate": "tsx scripts/media-renditions.ts validate",
    "media:renditions:cleanup": "tsx scripts/media-renditions.ts cleanup",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css}\" \"*.{json,js,ts,css,md}\""
  },
  "dependencies": {
    "animejs": "^4.4.1",
    "argon2": "^0.45.1",
    "embla-carousel-autoplay": "^8.6.0",
    "epubjs": "^0.3.93",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "flag-icons": "^7.5.0",
    "framer-motion": "^12.38.0",
    "hls.js": "^1.6.16",
    "lucide-react": "^0.468.0",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6"
  }
}
