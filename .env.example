# Frontend variables are read by Vite in the browser app. There is no server URL
# to configure: Seyirlik's API is served from the same origin as the page.

# Firebase Web app configuration. These values are public identifiers and are
# available in Firebase Console -> Project settings -> Your apps.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=replace-with-firebase-web-app-id
VITE_FIREBASE_ADMIN_EMAIL=sonatakcaa@gmail.com

# Backend variables are read by `npm run server` (and `npm run worker`).
# Both scripts load `.env` through Node's `--env-file=.env` flag.
SEYIRLIK_MEDIA_ROOT=/absolute/path/to/media
SEYIRLIK_TMDB_API_KEY=replace-with-a-tmdb-v3-api-key
# Firebase Admin verifies bearer tokens before serving artwork/admin routes.
# Point this to a downloaded service-account JSON file outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
SEYIRLIK_FIREBASE_PROJECT_ID=your-project-id
SEYIRLIK_FIREBASE_ADMIN_EMAIL=sonatakcaa@gmail.com
SEYIRLIK_ALLOWED_ORIGINS=https://www.seyirlik.org,https://seyirlik.org,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# If you open the frontend through a LAN IP, add that exact origin too:
# SEYIRLIK_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.186:5173

# Offline adaptive-rendition inventory and processing. Keep work and final output
# on the same volume so validated output is promoted by rename without copying
# media, but OUTSIDE SEYIRLIK_MEDIA_ROOT: library automation that scans the media
# root (FileFlows, Tdarr and similar) will otherwise re-encode or delete the
# generated renditions in place, and they then fail validation and vanish from
# the player.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# SEYIRLIK_RENDITION_ROOT=D:/seyirlik/renditions
# SEYIRLIK_RENDITION_WORK_ROOT=D:/seyirlik/work
# SEYIRLIK_RENDITION_STATE_ROOT=D:/seyirlik/state
# SEYIRLIK_RENDITION_LOG_ROOT=D:/seyirlik/logs
# SEYIRLIK_RENDITION_RESERVE_GB=25
# Video encoder for offline rendition generation. `auto` uses Intel QuickSync
# when a usable device is present and falls back to libx264, `qsv` requires
# QuickSync, `software` always uses libx264.
# SEYIRLIK_RENDITION_ENCODER=auto
# HDR handling. `preserve` keeps the HDR10 grade, which requires HEVC Main 10
# because no browser decodes 10-bit H.264 — those renditions are only offered to
# clients that report HEVC support. `tonemap` converts HDR to SDR H.264 instead,
# which plays everywhere but discards the HDR grade.
# SEYIRLIK_RENDITION_HDR=preserve

# (`X-Emby-Token`) by default. Set this to `disabled` only when the deployment

# Durable native identity is disabled by default. Before selecting `native`, run
# migrations and provision the first administrator against a protected PostgreSQL
# database. Keep all three secrets in the backend environment only.
# DATABASE_URL=postgresql://seyirlik@127.0.0.1:5432/seyirlik
SEYIRLIK_DATABASE_POOL_MAX=10
# SEYIRLIK_SESSION_HASH_SECRET=
# SEYIRLIK_CSRF_SECRET=
# Set the canonical browser origin when TLS terminates at a trusted proxy.
# SEYIRLIK_PUBLIC_ORIGIN=https://www.seyirlik.org

# Windows server example:
# SEYIRLIK_MEDIA_ROOT=D:/media

# ---------------------------------------------------------------------------
# Seyirlik's own media server (`npm run server`, worker via `npm run worker`).
#
# playback and background work all live behind /ownAPI/v1. It requires
# PostgreSQL and does not read any SEYIRLIK_JELLYFIN_* variable.
# ---------------------------------------------------------------------------
SEYIRLIK_HOST=127.0.0.1
SEYIRLIK_PORT=43110

# Libraries are declared as JSON. `roots` are paths relative to
# SEYIRLIK_MEDIA_ROOT, and `kind` is one of movies, series, books, collections,
# mixed. Editing this and restarting re-provisions libraries idempotently.
# SEYIRLIK_LIBRARIES=[{"slug":"movies","name":"Movies","kind":"movies","roots":["Movies"]},{"slug":"shows","name":"Shows","kind":"series","roots":["Shows"]}]

# Required before the server will start. Run `npm run db:migrate` first, then
# `npm run admin:provision` to create the first administrator.
# DATABASE_URL=postgresql://seyirlik@127.0.0.1:5432/seyirlik
# SEYIRLIK_SESSION_HASH_SECRET=
# SEYIRLIK_CSRF_SECRET=

# Metadata is optional. Without a TMDB key the catalogue still scans, probes and
# plays; titles are just what the folder names say and there is no artwork.
# The key stays in this process: it is never sent to a browser and never logged.
# SEYIRLIK_TMDB_API_KEY=replace-with-a-tmdb-v4-read-access-token

# Cached artwork is written under <SEYIRLIK_GENERATED_STORAGE>/images, keyed by
# content hash. Keep this off the media volume so library automation cannot
# delete it.
# SEYIRLIK_GENERATED_STORAGE=D:/seyirlik/generated
