# Seyirlik media server.
#
# Seyirlik serves its own API from this process. There is no Jellyfin, no server
# URL for the browser to configure, and no access token in local storage — the
# session is an HttpOnly cookie issued by this server.
#
# First run:
#   docker compose up -d          # PostgreSQL
#   npm run db:migrate
#   npm run admin:provision -- --username you --display-name "You"
#   npm run server

# ---------------------------------------------------------------- process
SEYIRLIK_HOST=127.0.0.1
SEYIRLIK_PORT=43110

# ------------------------------------------------------------------ media
SEYIRLIK_MEDIA_ROOT=/absolute/path/to/media

# Libraries are provisioned from this on every start, idempotently. `roots` are
# relative to SEYIRLIK_MEDIA_ROOT; `kind` is movies, series, books, collections
# or mixed. Folders you do not list are simply never scanned.
SEYIRLIK_LIBRARIES=[{"slug":"movies","name":"Movies","kind":"movies","roots":["Movies"]},{"slug":"series","name":"Series","kind":"series","roots":["Series"]},{"slug":"books","name":"Books","kind":"books","roots":["Books"]}]

# Cached artwork, trickplay sheets and HLS working files. Keep this OUTSIDE
# SEYIRLIK_MEDIA_ROOT: library automation that scans the media root (FileFlows,
# Tdarr and similar) will otherwise delete what Seyirlik generates.
SEYIRLIK_GENERATED_STORAGE=/absolute/path/to/generated

# --------------------------------------------------------------- database
# Required. The catalogue, watch state, sessions and job queue all live here, so
# the server refuses to start without it rather than running half-configured.
DATABASE_URL=postgresql://seyirlik:change-me@127.0.0.1:5432/seyirlik
# Read by docker-compose.yml; must match the password above.
SEYIRLIK_DB_PASSWORD=change-me
SEYIRLIK_DATABASE_POOL_MAX=10

# ---------------------------------------------------------------- secrets
# Two independent values, each at least 32 bytes. One keys the stored session
# token hash, the other signs CSRF tokens; reusing one for both is rejected.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SEYIRLIK_SESSION_HASH_SECRET=
SEYIRLIK_CSRF_SECRET=

# --------------------------------------------------------------- metadata
# Optional. Without it the catalogue still scans, probes and plays — titles are
# just what the folder names say, with no artwork.
#
# Both TMDB credential formats work: a v3 key (32 hex characters) travels as a
# query parameter, a v4 read access token as a bearer header. Backend only; this
# is never sent to a browser.
SEYIRLIK_TMDB_API_KEY=

# ----------------------------------------------------------------- ffmpeg
# Omit to use whatever is on PATH.
# SEYIRLIK_FFMPEG_PATH=ffmpeg
# SEYIRLIK_FFPROBE_PATH=ffprobe
# `auto`, `hardware`, `software`, or a specific encoder such as h264_qsv.
SEYIRLIK_FFMPEG_VIDEO_ENCODER=auto
SEYIRLIK_MAX_VIDEO_TRANSCODES=1
# SEYIRLIK_SOFTWARE_TRANSCODE_THREADS=4

# ------------------------------------------------------------------ hosting
# Set only when the app is served from a different host to this API — a static
# host in front, this server behind. Both must share a registrable domain, so
# requests between them stay same-site and the session cookie is still sent.
# Widening the cookie to the parent domain is what lets the app read the CSRF
# token this API issues.
#   SEYIRLIK_COOKIE_DOMAIN=example.org
# and build the frontend with VITE_OWN_API_BASE_URL=https://api.example.org
# SEYIRLIK_COOKIE_DOMAIN=

# Point this at the built frontend (`npm run build` writes ./dist) to serve the
# app and its API from one origin. That is what a public deployment wants: the
# session cookie is same-origin, no CORS exception is needed, and media bytes go
# straight from this process instead of through a proxy that would have to carry
# every stream.
# Leave it unset to serve only the API.
# SEYIRLIK_STATIC_ROOT=/absolute/path/to/dist

# ----------------------------------------------------------------- origins
# Browsers may call the API from these origins. Same-origin needs no entry, and
# production trusts nothing it was not told to trust.
SEYIRLIK_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set when TLS terminates at a trusted proxy, to the canonical browser origin.
# Forwarded headers are deliberately not trusted in its place.
# SEYIRLIK_PUBLIC_ORIGIN=https://www.seyirlik.org

# ------------------------------------------------------ offline renditions
# Pre-generated quality ladder (`npm run media:renditions:*`). Keep work and
# output on the same volume so validated output is promoted by rename, but
# outside SEYIRLIK_MEDIA_ROOT for the reason given above.
# SEYIRLIK_RENDITION_ROOT=/absolute/path/to/renditions
# SEYIRLIK_RENDITION_WORK_ROOT=/absolute/path/to/work
# SEYIRLIK_RENDITION_STATE_ROOT=/absolute/path/to/state
# SEYIRLIK_RENDITION_LOG_ROOT=/absolute/path/to/logs
# SEYIRLIK_RENDITION_RESERVE_GB=25
# SEYIRLIK_RENDITION_ENCODER=auto
# SEYIRLIK_RENDITION_HDR=preserve
